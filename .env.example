# Local development database. Prisma stores this SQLite file in the prisma/ folder.
DATABASE_URL="file:./dev.db"

# Replace this with a unique random secret of at least 32 characters.
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
